# Copy to `.env` and fill in. On the VPS, `.env` lives at /var/www/app/.env
# and is never overwritten by a deploy.

# Required. HMAC key for the signed `authSession` cookie.
# Must be at least 16 characters. In production the process refuses to boot
# without it (instrumentation.ts). Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
