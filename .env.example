# Copy to `.env` and fill in. On the VPS, `.env` lives at /var/www/app/.env
# and is never overwritten by a deploy.

# Required. HMAC key for the signed `authSession` cookie.
# Must be at least 16 characters. Required at runtime on the VPS.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# Origine de l'API pour le socket navigateur — sans /v3.
# Local : http://localhost:7001
# Prod  : https://api.afrue.com
NEXT_PUBLIC_API_URL=
